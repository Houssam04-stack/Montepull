@page "/cbn/simulation"
@page "/cbn/aps"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>CBN — Modes</PageTitle>

<PageHeader Title="CBN — Modes complémentaires"
            Description="Le parcours principal est le module unifié TUNIMAPULF (Duplication + CBN + Pegging)." />

<section class="card">
        <a class="btn-primary" href="/simulation-mrp?ensure=tunimapulf">Ouvrir CBN unifié (Duplication + Métier)</a>
        <a class="btn-secondary" href="/simulation-mrp?tab=metier">Onglet Métier</a>
</section>

@if (IsAps)
{
    <AlertPanel Variant="warning" Title="CBN APS segments">
        Moteur APS interne — expérimental.
    </AlertPanel>
    <section class="card">
        <a class="btn-secondary" href="/aps/cbn">Ouvrir CBN segments APS</a>
    </section>
}
else
{
    <AlertPanel Variant="info" Title="Simulation MRP">
        Même module que le CBN unifié — atelier technique.
    </AlertPanel>
    <section class="card">
        <a class="btn-secondary" href="/simulation-mrp?ensure=tunimapulf&amp;tab=duplication">Ouvrir Simulation MRP</a>
        <a class="btn-secondary" href="/cbn/legacy">CBN métier REAL (legacy)</a>
    </section>
}

@code {
    private bool IsAps
    {
        get
        {
            var path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
            return path.EndsWith("/aps", StringComparison.Ordinal);
        }
    }
}
