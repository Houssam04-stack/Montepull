    private async Task RunActionAsync(Func<Task> action)
    {
        _message = null;
        _isError = false;
        _isBusy = true;
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _isError = true;
        }
        finally
        {
            _isBusy = false;
        }
    }
