            await ReloadDataAsync();
        });
    }

    private async Task DuplicateFromRowAsync(ArticleListItem article)
    {
        if (string.IsNullOrWhiteSpace(_dupNewCode))
        {
            _message = "Indiquez un nouveau code.";
            _isError = true;
            return;
        }

        await RunActionAsync(async () =>
        {
            var result = await ArticleService.DuplicateArticleAsync(new DuplicateArticleRequest(
                article.Id, _dupNewCode.Trim(), null, false, false));
            _message = $"Article {result.Article.Code} dupliqué (session #{result.SessionId}).";
            if (result.BomLinkNote is not null)
            {
                _message += " " + result.BomLinkNote;
            }

            _dupEditingId = null;
            _dupNewCode = "";
            await ReloadDataAsync();
            _selectedArticleId = result.Article.Id;
            _selectedArticle = _articles.FirstOrDefault(a => a.Id == result.Article.Id);
        });
    }

