@page "/cbn/legacy"
@page "/cbn/reel"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>CBN métier</PageTitle>
<LoadingState Message="Ouverture du module CBN unifié…" />

@code {
    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        var tab = query.TryGetValue("tab", out var t) ? t.ToString().Trim().ToLowerInvariant() : "metier";
        var order = query.TryGetValue("order", out var o) ? o.ToString() : null;
        // /cbn/legacy?tab=cbn → calcul métier (pas CBN simulation)
        var targetTab = tab switch
        {
            "cbn" or "calcul" => "calcul",
            "commandes" or "lignes" => "commandes",
            "importees" or "import" => "importees",
            _ => "metier"
        };
        var target = $"/simulation-mrp?tab={Uri.EscapeDataString(targetTab)}";
        if (!string.IsNullOrWhiteSpace(order))
        {
            target += $"&order={Uri.EscapeDataString(order)}";
        }

        Navigation.NavigateTo(target, replace: true);
    }
}
