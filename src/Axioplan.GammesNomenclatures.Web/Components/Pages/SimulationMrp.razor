    private async Task DeleteBomLineAsync(SimulationBomLineDto line)
    {
        await RunAsync(async () =>
        {
            await SimulationService.DeleteSimBomLineAsync(new DeleteSimBomLineRequest(_selectedSimulationId, line.Id));
            await ReloadNomenclatureFromDbAsync();
            _message = $"Composant {line.ComponentCode} retire de la nomenclature (enregistre en base).";
        });
    }

    private async Task AddBomLineAsync()
    {
        await RunAsync(async () =>
        {
            if (_templateArticleId <= 0)
            {
                throw new InvalidOperationException("Choisissez un article template.");
            }

            var componentId = _newComponentArticleId;
            if (_useExistingComponent)
            {
                if (componentId <= 0)
                {
                    throw new InvalidOperationException("Choisissez un composant existant.");
                }
            }
            else
            {
                if (string.IsNullOrWhiteSpace(_newComponentCode))
                {
                    throw new InvalidOperationException("Le code du nouveau composant est requis.");
                }

                var created = await SimulationService.CreateSimArticleAsync(new CreateSimArticleRequest(
                    _selectedSimulationId,
                    _newComponentCode.Trim(),
                    string.IsNullOrWhiteSpace(_newComponentDesignation) ? _newComponentCode.Trim() : _newComponentDesignation.Trim(),
                    SimulationArticleTypes.Purchased,
                    _newComponentProcurement,
                    _newComponentLeadTime,
                    Unit: _newBomUnit));
                componentId = created.Id;
            }

            await SimulationService.UpsertSimBomLineAsync(new UpsertSimBomLineRequest(
                _selectedSimulationId,
                _templateArticleId,
                null,
                componentId,
                _newBomQty,
                ApplySizeCoefficient: _newBomSizeCoef,
                ApplyColorSubstitution: _newBomColorSub,
                Unit: _newBomUnit,
                NomenclatureType: SimulationNomenclatureTypes.Base,
                Alternative: 0));

            await SimulationService.EnsureAlternativeNomenclaturesAsync(_selectedSimulationId, _templateArticleId);
            await ReloadNomenclatureFromDbAsync();
            _newComponentArticleId = 0;
            _newComponentCode = string.Empty;
            _newComponentDesignation = string.Empty;
            _newBomQty = 1;
            _newBomUnit = SimulationBomUnits.Un;
            _newBomSizeCoef = false;
            _newBomColorSub = false;
            _message = "Ligne de nomenclature enregistree en base.";
        });
    }

    private async Task OnSimulationChangedAsync()
    {
        _cbnResult = null;
        SyncSimulationUri();
        await LoadSimulationDataAsync();
    }

    private async Task LoadSimulationDataAsync()
    {
        if (_selectedSimulationId <= 0)
        {
            return;
        }

        var previousTemplateId = _templateArticleId;
        var previousNomId = _nomBaseArticleId;
        _articles = (await SimulationService.GetArticlesAsync(_selectedSimulationId)).ToList();
        _bomLines = (await SimulationService.GetBomLinesAsync(_selectedSimulationId)).ToList();
        _parameters = (await SimulationService.GetParametersAsync(_selectedSimulationId)).ToList();
        _paramEdits.Clear();
        foreach (var p in EditableCbnParameters)
        {
            _paramEdits[p.ArticleId] = new ParamEdit
            {
                OnHandStock = p.OnHandStock,
                SafetyStock = p.SafetyStock,
                ReservedQuantity = p.ReservedQuantity,
                ScheduledReceiptProduction = p.ScheduledReceiptProduction,
                ScheduledReceiptPurchase = p.ScheduledReceiptPurchase,
                LeadTimeDays = p.LeadTimeDays,
                LotRule = p.LotRule,
                MinLot = p.MinLot,
                MultipleLot = p.MultipleLot
            };
        }

        var template = _articles.FirstOrDefault(a => a.Id == previousTemplateId && a.IsTemplate)
                        ?? _articles.FirstOrDefault(a => a.IsTemplate);
        _templateArticleId = template?.Id ?? 0;
        if (previousNomId > 0 && _articles.Any(a => a.Id == previousNomId))
        {
            _nomBaseArticleId = previousNomId;
        }
        else if (_nomBaseArticleId <= 0 && _templateArticleId > 0)
        {
            _nomBaseArticleId = _templateArticleId;
        }

        SyncBomLineEdits();

        var generated = _articles.FirstOrDefault(a => a.Code == "PANTALON_NOIR_L")
                        ?? _articles.FirstOrDefault(a => a.IsGenerated);
        if (generated is not null)
        {
            _cbnArticleId = generated.Id;
        }

        await LoadDuplicationOptionsAsync();
        await LoadCbnHistoryAsync();
    }

    private async Task LoadCbnHistoryAsync()
    {
        if (_selectedSimulationId <= 0)
        {
            _cbnHistory = [];
            _selectedRunId = 0;
