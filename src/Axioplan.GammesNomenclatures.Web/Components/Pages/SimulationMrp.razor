    private void OpenCbnForArticle(SimulationArticleDto article)
    {
        // Lien Duplication → CBN : conserve SimulationId + ArticleId, préremplit l'onglet CBN.
        _cbnArticleId = article.Id;
        _orderNumber = string.IsNullOrWhiteSpace(_orderNumber) || _orderNumber.StartsWith("CMD-", StringComparison.OrdinalIgnoreCase)
            ? $"CMD-{article.Code}"
            : _orderNumber;
        if (string.IsNullOrWhiteSpace(_customerName))
        {
            _customerName = "Client simulation";
        }

        _cbnResult = null;
        _selectedRunId = 0;
        _resultTab = "bom";
        _activeTab = "cbn";
        _message = $"CBN préselectionné : {article.Code} (simulation #{_selectedSimulationId}). Ajustez qty/date puis lancez le calcul.";
        Navigation.NavigateTo($"/simulation-mrp?simulationId={_selectedSimulationId}&tab=cbn", replace: true);
    }

    private async Task SaveParamAsync(int articleId)
    {
        await RunAsync(async () =>
        {
            var edit = _paramEdits[articleId];
            await SimulationService.UpdateParameterAsync(new UpdateSimCbnParameterRequest(
                _selectedSimulationId,
                articleId,
                edit.OnHandStock,
                edit.SafetyStock,
                edit.ReservedQuantity,
                edit.ScheduledReceiptProduction,
                edit.ScheduledReceiptPurchase,
                edit.LeadTimeDays,
                edit.LotRule,
                edit.MinLot,
                edit.MultipleLot));
            _parameters = (await SimulationService.GetParametersAsync(_selectedSimulationId)).ToList();
            _message = "Parametres CBN enregistres.";
        });
    }

    private async Task RunCbnAsync()
    {
        await RunAsync(async () =>
        {
            if (_cbnArticleId <= 0)
            {
                throw new InvalidOperationException("Choisissez un article genere.");
            }

            var so = await SimulationService.UpsertSalesOrderAsync(new UpsertSalesOrderRequest(
                _selectedSimulationId,
                _customerName,
                _orderNumber,
                _cbnArticleId,
                _orderQty,
                DateOnly.FromDateTime(_requestedDate)));

            var run = await CbnApplication.RunSimulationAsync(new CbnRunRequestDto(
                _selectedSimulationId,
                so.Id,
                _cbnArticleId,
                _orderQty,
                DateOnly.FromDateTime(_requestedDate)));

            _cbnResult = run.Result;

            _selectedRunId = _cbnResult.RunId;
            _resultTab = "trace";
            await LoadCbnHistoryAsync();
            _message = $"CBN termine (#{_cbnResult.RunId}) — {_cbnResult.PlannedOrders.Count} ordres, {_cbnResult.Alerts.Count} alertes.";
        });
    }

    private RenderFragment RenderPegging(PeggingNodeDto node, int depth) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "style", $"padding-left:{depth * 1.25}rem;margin:0.2rem 0");
        builder.AddContent(2, $"{(depth == 0 ? "●" : "└")} {node.ArticleCode} — qty {node.Quantity:F3} — {node.SourceType} — {node.NeedDate}");
        builder.OpenElement(3, "div");
        builder.AddAttribute(4, "class", "subtle");
        builder.AddContent(5, node.Path);
        builder.CloseElement();
        builder.CloseElement();
        foreach (var child in node.Children)
        {
            builder.AddContent(10 + depth, RenderPegging(child, depth + 1));
        }
    };

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

