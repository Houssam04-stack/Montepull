    private async Task LoadDuplicationOptionsAsync()
    {
        if (_selectedSimulationId <= 0)
        {
            _sizes = [];
            _colors = [];
            return;
        }

        await SimulationService.EnsureDefaultDuplicationOptionsAsync(_selectedSimulationId);
        var options = await SimulationService.GetDuplicationOptionsAsync(_selectedSimulationId);
        _sizes = options.Sizes
            .Select(s => new SizeEdit(s.Size, s.Coefficient, s.IsSelected))
            .ToList();
        _colors = options.Colors
            .Select(c => new ColorEdit(c.Color, c.Coefficient, c.IsSelected))
            .ToList();
    }

    private async Task SaveDuplicationOptionsAsync()
    {
        if (_selectedSimulationId <= 0 || _busy)
        {
            return;
        }

        try
        {
            await SimulationService.SaveDuplicationOptionsAsync(new SaveDuplicationOptionsRequest(
                _selectedSimulationId,
                _sizes.Select((s, index) => new DuplicationSizeOptionDto(
                    s.Size.Trim(),
                    s.Coefficient,
                    s.Selected,
                    index)).ToList(),
                _colors.Select((c, index) => new DuplicationColorOptionDto(
                    c.Color.Trim(),
                    c.Coefficient,
                    c.Selected,
                    index)).ToList()));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task GenerateVariantsAsync()
    {
        await RunAsync(async () =>
        {
            if (_templateArticleId <= 0)
            {
                throw new InvalidOperationException("Choisissez un article template (seed ou creation d'abord).");
            }

            var selectedSizes = _sizes
                .Where(s => s.Selected && !string.IsNullOrWhiteSpace(s.Size))
                .Select(s => new SizeCoefficientInput(s.Size.Trim(), s.Coefficient))
                .ToList();
            var selectedColors = _colors
                .Where(c => c.Selected && !string.IsNullOrWhiteSpace(c.Color))
                .Select(c => new ColorCoefficientInput(c.Color.Trim(), c.Coefficient))
                .ToList();

            if (selectedSizes.Count == 0)
            {
                throw new InvalidOperationException("Cochez au moins une taille a dupliquer.");
            }

            if (selectedColors.Count == 0)
            {
                throw new InvalidOperationException("Cochez au moins une couleur a dupliquer.");
            }

            if (selectedSizes.Any(s => s.Coefficient <= 0) || selectedColors.Any(c => c.Coefficient <= 0))
            {
                throw new InvalidOperationException("Les coefficients doivent etre strictement positifs.");
            }

            var result = await DuplicationService.GenerateVariantsAsync(new GenerateVariantsRequest(
                _selectedSimulationId,
                _templateArticleId,
                selectedSizes,
                selectedColors));

            await LoadSimulationDataAsync();
            _message = $"{result.GeneratedArticles.Count} variante(s) generee(s) ({selectedSizes.Count} taille(s) × {selectedColors.Count} couleur(s)).";
        });
    }

    private async Task AddSize()
    {
        var name = _newSizeName.Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            _error = "Saisissez un nom de taille.";
            return;
        }

        if (_sizes.Any(s => string.Equals(s.Size, name, StringComparison.OrdinalIgnoreCase)))
        {
            _error = $"La taille '{name}' existe deja.";
            return;
        }

        if (_newSizeCoefficient <= 0)
        {
            _error = "Le coefficient taille doit etre > 0.";
            return;
        }

        _error = null;
        _sizes.Add(new SizeEdit(name, _newSizeCoefficient, selected: true));
        _newSizeName = string.Empty;
        _newSizeCoefficient = 1.0;
        await SaveDuplicationOptionsAsync();
    }

